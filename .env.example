# Copy to .env and fill in. Only BOT_TOKEN is required.

# Telegram bot token from @BotFather
BOT_TOKEN=123456789:your-telegram-bot-token-from-botfather
# Channel gate: off unless true. The bot must be an admin of every channel.
GATE_ENABLED=false
# Up to 6 channels, comma-separated: @username|join link, or -100...id|invite link
GATE_CHANNELS=@yourchannel|https://t.me/yourchannel
# Or one channel the older way (REQUIRED_CHANNEL / CHANNEL_INVITE_LINK also work)
CHANNEL_ID=
CHANNEL_LINK=

# SQLite file location. Default: $RAILWAY_VOLUME_MOUNT_PATH/expenses.db, else ./data/expenses.db
# (an existing ./finance_bot.db is used if present)
DB_PATH=
# Base URL for the webhook and Mini App. Default: https://$RAILWAY_PUBLIC_DOMAIN
PUBLIC_URL=
# Checked on every webhook call. Required in production (32+ random characters)
WEBHOOK_SECRET=
# There is no app-wide currency or timezone: each user picks their own on /start.
# Chat that receives backups and error alerts (optional)
ADMIN_CHAT_ID=
# Local development without a webhook
USE_POLLING=false
# Set by Railway
PORT=8000
